{% set indexId = 'entity-index-' ~ entity ~ '-' ~ random() %}
<div data-controller="entity--index-table" class="entity-index {{ app.request.query.get('dialog') == '1' ? 'dialog-index-table' : '' }}">
{% if app.request.query.get('dialog') != '1' %}
<h2 class="m-2">{{ labelPlural }} - Overzichtspagina</h2>
{% endif %}
<div class="text-muted m-2">
    {{ labelPlural }}: {{ from }} - {{ to }} van {{ total }}
</div>
{% block flash_messages %}
<div class="my-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>
{% endblock %}

<form
    id="{{ indexId }}-filters"
    method="get"
    action="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}"
    data-entity--index-table-target="form"
    data-action="submit->entity--index-table#search"
    data-current-page="{{ page }}"
    data-dialog="{{ app.request.query.get('dialog') }}"
    data-form-id="{{ app.request.query.get('form_id') }}"
    data-item-count="{{ app.request.query.get('itemCount') }}"
    data-columns="{{ app.request.query.all('columns') ? app.request.query.all('columns')|join(',') : app.request.query.get('columns') }}"
>
{% if sortField %}
    <input type="hidden" name="sortField" value="{{ sortField }}">
    <input type="hidden" name="sortDirection" value="{{ sortDirection }}">
{% endif %}
</form>
<form method="post" action="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}{{ app.request.queryString ? '?' ~ app.request.queryString : '' }}">
<input type="hidden" name="_token" value="{{ csrf_token('index_bulk_action_' ~ app.request.attributes.get('_route')) }}">
{% if app.request.query.get('dialog') %}
    <input type="hidden" name="dialog" value="{{ app.request.query.get('dialog') }}">
{% endif %}
{% if app.request.query.get('form_id') %}
    <input type="hidden" name="form_id" value="{{ app.request.query.get('form_id') }}">
{% endif %}
{% if app.request.query.get('itemCount') %}
    <input type="hidden" name="itemCount" value="{{ app.request.query.get('itemCount') }}">
{% endif %}
{% if app.request.query.all('columns') %}
    {% for column in app.request.query.all('columns') %}
        <input type="hidden" name="columns[]" value="{{ column }}">
    {% endfor %}
{% elseif app.request.query.get('columns') %}
    <input type="hidden" name="columns" value="{{ app.request.query.get('columns') }}">
{% endif %}
{% if sortField %}
    <input type="hidden" name="sortField" value="{{ sortField }}">
    <input type="hidden" name="sortDirection" value="{{ sortDirection }}">
{% endif %}
{% block before_table %}
{% endblock %}
    <div class="entity-index-mobile-toolbar" role="group" aria-label="Overzicht aanpassen">
        <button type="button" class="btn-app btn-app-icon text-muted" data-popup="sort" data-action="entity--index-table#openPopup">
            <i class="fa fa-sort text-color-primary"></i>
            Sorteren
        </button>
        <button type="button" class="btn-app btn-app-icon text-muted" data-popup="search" data-action="entity--index-table#openPopup">
            <i class="fa fa-magnifying-glass text-color-primary"></i>
            Zoeken
        </button>
        <button type="button" class="btn-app btn-app-icon text-muted" data-popup="filter" data-action="entity--index-table#openPopup">
            <i class="fa fa-filter text-color-primary"></i>
            Filteren
        </button>
    </div>
<table class="table table-striped entity-index-table" id="{{ entity }}-index-table">
    <thead>
        <tr>
        {% if showTableCheckboxes %}
            <th scope="col">
                <input
                    type="checkbox"
                    aria-label="Selecteer alle zichtbare rijen"
                    data-action="change->entity--index-table#selectAll"
                >
            </th>
        {% endif %}
        {% for field, column in columns %}
            {% set activeSort = sortField == field %}
            {% set nextDirection = activeSort and sortDirection == 'ASC' ? 'DESC' : 'ASC' %}
            <th scope="col" aria-sort="{{ activeSort ? (sortDirection == 'ASC' ? 'ascending' : 'descending') : 'none' }}">
                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({sortField: field, sortDirection: nextDirection, page: 1})) }}"
                   class="text-reset text-decoration-none"
                   data-action="click->entity--index-table#sort"
                   data-sort-field="{{ field }}"
                   data-sort-direction="{{ nextDirection }}">
                    {{ column.label }}{% if activeSort %} <span aria-hidden="true">{{ sortDirection == 'ASC' ? '↑' : '↓' }}</span>{% endif %}
                </a>
            </th>
        {% endfor %}
        </tr>
    </thead>
    <tbody>
        <tr class="entity-index-filters">
            {% if showTableCheckboxes %}
                <td></td>
            {% endif %}
            {% set i = 0 %}
            {% for field, column in columns %}
                {% set i = i + 1 %}
                <td>
                    <input form="{{ indexId }}-filters" type="hidden" name="filter{{ i }}Field" value="{{ field }}">
                    <input
                        form="{{ indexId }}-filters"
                        name="filter{{ i }}Value"
                        value="{{ app.request.query.get('filter' ~ i ~ 'Value') }}"
                        placeholder="Zoek..."
                        class="form-control">
                </td>
            {% endfor %}
        </tr>
    {% for item in items %}
        <tr class="item-row {{ app.request.query.get('dialog') == '1' ? 'dialog-selectable-row' : '' }}"
            data-id="{{ item._id }}"
            {% if app.request.query.get('dialog') == '1' %}
                data-label="{{ item._label }}"
            {% else %}
                data-tutorial-navigate-url="{{ item._route }}"
                onclick="window.location='{{ item._route }}'"
            {% endif %}
            style="{{ app.request.query.get('dialog') == '1' ? 'cursor: pointer;' : '' }}"
        >
            {% if showTableCheckboxes %}
                <td>
                    <input
                        type="checkbox"
                        name="selected[]"
                        value="{{ item._id }}"
                        aria-label="Selecteer rij"
                        data-index-table-checkbox
                        data-action="click->entity--index-table#stopRowNavigation change->entity--index-table#syncSelectAll"
                    >
                </td>
            {% endif %}
            {% for key, column in item %}
                {% if key starts with '_' %}

                {% else %}
                <td data-column-label="{{ columns[key].label }}">
                    <span class="entity-index-card-label">{{ columns[key].label }}</span>
                    <div class="entity-index-card-value">
                    {% if columns[key].raw|default(false) %}
                        {{ column|raw }}
                    {% else %}
                        {{ column }}
                    {% endif %}
                    </div>
                </td>
                {% endif %}
            {% endfor %}
        </tr>
    {% else %}
        <tr><td colspan="{{ columns|length + (showTableCheckboxes ? 1 : 0) }}">Geen resultaten gevonden.</td></tr>
    {% endfor %}
    </tbody>
</table>
<button type="submit" form="{{ indexId }}-filters" hidden></button>
<div class="table-info d-flex justify-content-between flex-row">
    <div class="text-muted mx-2 w-25">
        Pagina: {{ page }} van {{ pages }}
    </div>
    <div class="pagination-buttons d-flex flex-row justify-content-start w-25">
        <button
            class="btn-app btn-app-icon pagination-button back"
            {{ (page == 1) ? 'disabled' : '' }}
            data-page="back"
            data-min="{{ 1 }}"
            data-action="click->entity--index-table#paginate"
        >
            <i class="fa fa-angle-left"></i>
        </button>
        {% for pageIdx in 1..pages %}
            <button class="btn-app btn-app-icon pagination-button {{ pageIdx == page ? 'active' : '' }}" data-page="{{ pageIdx }}" data-action="click->entity--index-table#paginate">
                {{ pageIdx }}
            </button>
        {% endfor %}
        <button
            class="btn-app btn-app-icon pagination-button next"
            {{ (page == pages) ? 'disabled' : '' }}
            data-page="next"
            data-max="{{ pages }}"
            data-action="click->entity--index-table#paginate"
        >
            <i class="fa fa-angle-right"></i>
        </button>
    </div>
    <div class="w-25">

    </div>
</div>
    {% if app.request.query.get('dialog') != '1' %}
<div class="d-flex flex-row gap-3 m-2">
    {% for button in buttons %}
        {% if button.type === 'link' %}
        <a id="{{ button.id }}" href="{{ path(button.route) }}" class="btn-app btn-app-{{ button.css }}">
            {{ button.label }}
        </a>
        {% elseif button.type === 'submit' %}
        <button
            type="submit"
            id="{{ button.id }}"
            name="action"
            value="{{ button.action }}"
            class="btn-app btn-app-{{ button.css }}"
            {% if showTableCheckboxes %}
                data-action="click->entity--index-table#confirmBulkAction"
                data-confirm-message="{{ button.confirmMessage|default('Weet je zeker dat je deze actie wil uitvoeren voor de geselecteerde items?') }}"
            {% endif %}
        >
            {{ button.label }}
        </button>
        {% endif %}
    {% endfor %}
</div>
{% endif %}
</form>
{% for popup, title in {sort: 'Sorteren', search: 'Zoeken', filter: 'Filteren'} %}
<dialog class="entity-index-popup" data-index-popup="{{ popup }}" aria-labelledby="{{ indexId }}-{{ popup }}-title">
    <form data-popup="{{ popup }}" data-action="submit->entity--index-table#applyPopup">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 id="{{ indexId }}-{{ popup }}-title" class="h5 mb-0">{{ title }}</h3>
            <button type="button" class="btn-close" aria-label="Sluiten" data-action="entity--index-table#closePopup"></button>
        </div>
        {% if popup == 'sort' or popup == 'search' %}
            <label class="form-label" for="{{ indexId }}-{{ popup }}-field">Kolom</label>
            <select class="form-select mb-3" id="{{ indexId }}-{{ popup }}-field" name="field" {% if popup == 'search' %}data-action="change->entity--index-table#syncSearchField"{% endif %}>
                {% for field, column in columns %}
                    {% if popup == 'sort' or column.filter|default(null) is not null %}
                    <option value="{{ field }}" {{ popup == 'sort' and sortField == field ? 'selected' : '' }}>{{ column.label }}</option>
                    {% endif %}
                {% endfor %}
            </select>
            {% if popup == 'sort' %}
                <label class="form-label" for="{{ indexId }}-sort-direction">Volgorde</label>
                <select class="form-select mb-3" id="{{ indexId }}-sort-direction" name="direction">
                    <option value="ASC" {{ sortDirection == 'ASC' ? 'selected' : '' }}>Oplopend</option>
                    <option value="DESC" {{ sortDirection == 'DESC' ? 'selected' : '' }}>Aflopend</option>
                </select>
            {% else %}
                <label class="form-label" for="{{ indexId }}-search-value">Zoekterm</label>
                <input class="form-control mb-3" type="search" id="{{ indexId }}-search-value" name="value" placeholder="Zoek...">
            {% endif %}
        {% else %}
            <p class="text-muted">Vul één of meer kolommen in om te filteren.</p>
            {% for field, column in columns %}
                {% if column.filter|default(null) is not null %}
                <label class="form-label" for="{{ indexId }}-filter-{{ loop.index }}">{{ column.label }}</label>
                <input class="form-control mb-3" id="{{ indexId }}-filter-{{ loop.index }}" data-filter-index="{{ loop.index }}" placeholder="Zoek...">
                {% endif %}
            {% endfor %}
            <button type="button" class="btn btn-link" data-action="entity--index-table#clearPopupFilters">Filters wissen</button>
        {% endif %}
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary" data-action="entity--index-table#closePopup">Annuleren</button>
            <button type="submit" class="btn btn-primary">Toepassen</button>
        </div>
    </form>
</dialog>
{% endfor %}
<style>
.entity-index-mobile-toolbar, .entity-index-card-label { display: none; }
.entity-index-popup { border: 0; border-radius: 1rem; padding: 1.25rem; width: min(32rem, calc(100% - 2rem)); max-height: 85dvh; overflow-y: auto; }
.entity-index-popup::backdrop { background: rgb(0 0 0 / 45%); }
.entity-index-card-value { overflow-wrap: anywhere; }
@media (max-width: 767.98px) {
    .entity-index-mobile-toolbar { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem .5rem; }
    .entity-index-table, .entity-index-table tbody { display: block; width: 100%; }
    .entity-index-table thead, .entity-index-table .entity-index-filters { display: none; }
    .entity-index-table .item-row { display: block; margin: .75rem .5rem; padding: .75rem; border: 1px solid var(--bs-border-color, #ddd); border-radius: .75rem; background: var(--bs-body-bg, white); }
    .entity-index-table .item-row > td { display: block; border: 0; padding: .4rem; box-shadow: none; background: transparent; }
    .entity-index-card-label { display: block; font-size: .8rem; font-weight: 600; color: var(--bs-secondary-color, #666); margin-bottom: .15rem; }
    .entity-index .table-info { flex-wrap: wrap; gap: .75rem; }
    .entity-index .table-info > .w-25 { width: auto !important; }
    .entity-index .pagination-buttons { max-width: 100%; overflow-x: auto; }
    .entity-index .pagination-button { flex-shrink: 0; }
}
</style>
</div>
